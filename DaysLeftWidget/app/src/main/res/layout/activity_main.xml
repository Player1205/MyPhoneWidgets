<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/widget_card_background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Title -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="⏳ Days Left Widget"
            android:textColor="@color/text_title"
            android:textSize="24sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Cyber Amber Hero Widget for Samsung Galaxy M35 5G"
            android:textColor="@color/text_muted"
            android:textSize="13sp" />

        <!-- Widget Live Preview Card -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="LIVE WIDGET PREVIEW"
            android:textColor="@color/text_muted"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.08" />

        <include
            android:id="@+id/preview_widget"
            layout="@layout/widget_days_left"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <!-- Personal Quotes Vault -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/quote_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✍️ Personal Quotes Vault (Quotes by You)"
                android:textColor="@color/text_title"
                android:textSize="14sp"
                android:textStyle="bold" />

            <!-- Rotation Status Description -->
            <TextView
                android:id="@+id/tv_vault_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="1 quote active. Add more to enable 3-hour auto-shuffle!"
                android:textColor="@color/hero_days_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <!-- Input to Add New Quote -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/et_new_quote"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:background="@color/input_bg"
                    android:hint="Type a quote you wrote..."
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:textColor="@color/white"
                    android:textColorHint="@color/text_muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_add_quote"
                    android:layout_width="wrap_content"
                    android:layout_height="46dp"
                    android:layout_marginStart="8dp"
                    android:backgroundTint="@color/hero_days_color"
                    android:text="+ Add"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Quotes List Container -->
            <LinearLayout
                android:id="@+id/container_quotes_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Add Widget Button -->
        <Button
            android:id="@+id/btn_pin_widget"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="@color/hero_days_color"
            android:text="⚡ Add Widget to Home Screen"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Instructions Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/quote_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 How to place on Samsung Home Screen:"
                android:textColor="@color/text_title"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingExtra="3dp"
                android:text="1. Tap the button above, or go to your Home Screen.\n2. Long-press empty space on screen.\n3. Tap 'Widgets' &gt; 'Days Left Widget'.\n4. Drag it to your desired spot.\n5. Resize width to span nicely across your screen."
                android:textColor="@color/text_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Tap Tip -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"
            android:text="💡 Tip: Quotes shuffle automatically every 3 hours. Tapping the widget previews the next quote anytime."
            android:textColor="@color/hero_days_color"
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>