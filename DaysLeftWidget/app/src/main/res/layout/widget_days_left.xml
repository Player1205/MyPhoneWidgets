<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Translucent Curved Card (Wallpaper visible through frosted dark glass) -->
    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg">

        <!-- Dynamic 365 Year Dots Matrix Canvas -->
        <ImageView
            android:id="@+id/iv_year_dots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <!-- Card Content Foreground Layer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Top Header: Clean Year Label & Direct Add Quote Shortcut -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_year_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="in 2026"
                    android:textColor="@color/text_header_muted"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/btn_quick_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="2dp"
                    android:text="✍️"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Centerpiece Hero: Massive Kinetic Slanted "66 days left" Filling Majority of Widget Area -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tv_days_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="66 days left"
                    android:textColor="@color/hero_days_color"
                    android:textSize="50sp"
                    android:textStyle="bold|italic"
                    android:fontFamily="sans-serif-black"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeMaxTextSize="64sp"
                    android:autoSizeStepGranularity="2sp"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.03"
                    android:shadowColor="#80000000"
                    android:shadowDx="0"
                    android:shadowDy="3"
                    android:shadowRadius="10" />
            </LinearLayout>

            <!-- Bottom: User Quote Section -->
            <LinearLayout
                android:id="@+id/quote_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_quote_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="QUOTE BY ME:"
                    android:textColor="@color/quote_label_color"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.06"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_quote_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="“i am one of the few”"
                    android:textColor="@color/quote_text_color"
                    android:textSize="15sp"
                    android:textStyle="italic"
                    android:fontFamily="serif"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</FrameLayout>