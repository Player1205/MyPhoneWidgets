<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Translucent Curved Card (Wallpaper visible through frosted dark glass) -->
    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg">

        <!-- Dynamic 365 Year Dots Matrix Canvas (Wrapping around text with zero overlap) -->
        <ImageView
            android:id="@+id/iv_year_dots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <!-- Card Content Foreground Layer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingEnd="22dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <!-- Top Header: Clean Year Label & Direct Add Quote Shortcut -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_year_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:text="in 2026"
                    android:textColor="@color/text_header_muted"
                    android:textSize="13sp"
                    android:textStyle="normal"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/btn_quick_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="2dp"
                    android:text="✍️"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Centerpiece Hero: Playfair Display ExtraBold Italic with Radiant Cyber Amber Glow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="2dp"
                android:paddingBottom="2dp">

                <TextView
                    android:id="@+id/tv_days_hero"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="66 days left"
                    android:textColor="@color/hero_days_color"
                    android:textSize="54sp"
                    android:textStyle="italic"
                    android:fontFamily="@font/playfair_display_italic"
                    android:autoSizeTextType="uniform"
                    android:autoSizeMinTextSize="28sp"
                    android:autoSizeMaxTextSize="68sp"
                    android:autoSizeStepGranularity="2sp"
                    android:includeFontPadding="false"
                    android:letterSpacing="-0.02"
                    android:shadowColor="#B3FFB703"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10" />
            </LinearLayout>

            <!-- Bottom: User Quote Section (Bigger & in Playfair Display Bold Italic) -->
            <LinearLayout
                android:id="@+id/quote_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_quote_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="quote by me:"
                    android:textColor="@color/quote_label_color"
                    android:textSize="11sp"
                    android:letterSpacing="0.06"
                    android:includeFontPadding="false" />

                <TextView
                    android:id="@+id/tv_quote_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:text="“i am one of the few”"
                    android:textColor="@color/quote_text_color"
                    android:textSize="18sp"
                    android:textStyle="italic"
                    android:fontFamily="@font/playfair_display_quote"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:lineSpacingExtra="3dp"
                    android:shadowColor="#99000000"
                    android:shadowDx="0"
                    android:shadowDy="2"
                    android:shadowRadius="6" />
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</FrameLayout>
