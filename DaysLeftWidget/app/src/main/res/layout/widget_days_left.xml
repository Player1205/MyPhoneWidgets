<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingStart="6dp"
    android:paddingEnd="6dp"
    android:paddingTop="5dp"
    android:paddingBottom="5dp">

    <!-- Translucent Curved Card (Frosted dark obsidian glass) -->
    <FrameLayout
        android:id="@+id/widget_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_card_bg">

        <!-- Complete 365 Year Dots Matrix Canvas (Uniform Starry Field) -->
        <ImageView
            android:id="@+id/iv_year_dots"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="fitXY"
            android:contentDescription="@null" />

        <!-- Foreground Content Layer -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <!-- Top Header: Year Capsule & Direct Add Quote Shortcut -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tv_year_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/scrim_capsule_year"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="3dp"
                    android:paddingBottom="3dp"
                    android:text="in 2026"
                    android:textColor="@color/text_header_muted"
                    android:textSize="12sp"
                    android:textStyle="normal"
                    android:letterSpacing="0.04" />

                <TextView
                    android:id="@+id/btn_quick_add"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:padding="2dp"
                    android:text="✍️"
                    android:textSize="13sp" />
            </RelativeLayout>

            <!-- Centerpiece Hero: Translucent Scrim Plinth with Playfair ExtraBold Italic -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingTop="3dp"
                android:paddingBottom="3dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/scrim_capsule_hero"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp">

                    <TextView
                        android:id="@+id/tv_days_hero"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="66 days left"
                        android:textColor="@color/hero_days_color"
                        android:textSize="52sp"
                        android:textStyle="italic"
                        android:fontFamily="@font/playfair_display_italic"
                        android:autoSizeTextType="uniform"
                        android:autoSizeMinTextSize="28sp"
                        android:autoSizeMaxTextSize="68sp"
                        android:autoSizeStepGranularity="2sp"
                        android:includeFontPadding="false"
                        android:letterSpacing="-0.02"
                        android:shadowColor="#B3FFB703"
                        android:shadowDx="0"
                        android:shadowDy="0"
                        android:shadowRadius="10" />
                </FrameLayout>
            </LinearLayout>

            <!-- Bottom: User Quote Section (Translucent Scrim Plinth) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center">

                <LinearLayout
                    android:id="@+id/quote_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/scrim_capsule_quote"
                    android:paddingStart="22dp"
                    android:paddingEnd="22dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="7dp"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tv_quote_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="quote by me:"
                        android:textColor="@color/quote_label_color"
                        android:textSize="11sp"
                        android:letterSpacing="0.06"
                        android:includeFontPadding="false" />

                    <TextView
                        android:id="@+id/tv_quote_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center"
                        android:text="“i am one of the few”"
                        android:textColor="@color/quote_text_color"
                        android:textSize="17sp"
                        android:textStyle="italic"
                        android:fontFamily="@font/playfair_display_quote"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:lineSpacingExtra="3dp"
                        android:shadowColor="#99000000"
                        android:shadowDx="0"
                        android:shadowDy="2"
                        android:shadowRadius="6" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

    </FrameLayout>
</FrameLayout>
